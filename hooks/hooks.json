{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\"; if [ -f \"$f\" ]; then sh \"$f\" guard-commit.js; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\"; if [ -f \"$f\" ]; then sh \"$f\" guard-adr.js; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\"; if [ -f \"$f\" ]; then sh \"$f\" nudge-doc-sync.js; fi"
          }
        ]
      }
    ]
  }
}
